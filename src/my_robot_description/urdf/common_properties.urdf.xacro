<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="teal">
        <color rgba="0 0.502 0.502 1" />
    </material>

    <material name="pink">
        <color rgba="1.0 0.53 0.7 1.0" />
    </material>

    <material name="orange">
        <color rgba="0.8 0.4 0.0 1.0" />
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0" />
    </material>

    <material name="color_1">
        <color rgba="0.941 0.573 0.804 1.0" />
    </material>

    <material name="color_2">
        <color rgba="0.800 0.267 0.294 1.0" />
    </material>

    <material name="color_3">
        <color rgba="0.957 0.910 0.757 1.0" />
    </material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0"
                     izz="${(m/12) * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
                     izz="${(m*r*r/2)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(2*m*r*r)/5}" ixy="0" ixz="0"
                     iyy="${(2*m*r*r)/5}" iyz="0"
                     izz="${(2*m*r*r)/5}" />
        </inertial>
    </xacro:macro>

</robot>